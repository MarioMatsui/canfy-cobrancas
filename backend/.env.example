# Backend
# Local (docker-compose): postgresql://postgres:postgres@localhost:5437/asaas_split
# Supabase (Supavisor Session Pooler, porta 5432): postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asaas_split
ASAAS_API_KEY=your_asaas_api_key_here
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# Opcional. Configure somente com um dominio autorizado nos dados comerciais da conta Asaas.
# ASAAS_PAYMENT_CALLBACK_BASE_URL=https://pagar.canfy.com.br
JWT_SECRET=your_jwt_secret_change_in_production

# Webhook Asaas
# Use um segredo exclusivo de 32 a 255 caracteres, sem espacos e diferente da API key.
WEBHOOK_SECRET=replace_with_a_secure_webhook_secret_32_chars_min
# Em producao, o backend garante de forma idempotente que o webhook exista/esteja ativo.
ASAAS_WEBHOOK_AUTO_CONFIGURE=true
# Opcional: sobrescreve a URL derivada de FRONTEND_URL.
# ASAAS_WEBHOOK_URL=https://cobranca.canfy.com.br/api/webhooks/asaas
# Opcional: necessario apenas se a conta Asaas nao retornar e-mail comercial.
# ASAAS_WEBHOOK_EMAIL=operacao@canfy.com.br

REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3001
FRONTEND_URL=http://localhost:3000
CHECKOUT_FRONTEND_URL=http://localhost:4020
