generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum SubaccountType {
  DOCTOR
  SUPPLIER
  OTHER
}

enum ChargeType {
  CUSTOM    // Cobrança avulsa/personalizada
  REUSABLE  // Cobrança reutilizável (link permanente)
}

enum UserRole {
  ADMIN
  ATTENDANT
}

// ==========================================
// USUÁRIOS DO PAINEL
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  salt      String
  name      String
  role      UserRole @default(ATTENDANT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ==========================================
// SUBCONTAS ASAAS (Médicos, Fornecedores, etc.)
// ==========================================

model Subaccount {
  id          String          @id @default(uuid())
  asaasId     String          @unique @map("asaas_id")
  walletId    String?         @map("wallet_id")
  apiKey      String?         @map("api_key")
  name        String
  cpfCnpj     String          @map("cpf_cnpj")
  email       String?
  phone       String?
  mobilePhone String?         @map("mobile_phone")
  type        SubaccountType  @default(OTHER)
  active      Boolean         @default(true)
  balance     Decimal         @default(0) @db.Decimal(12, 2)
  deletedAt   DateTime?       @map("deleted_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  chargeSplits ChargeSplit[]
  splitResults SplitResult[]

  @@index([type])
  @@map("subaccounts")
}

// ==========================================
// COBRANÇAS (Avulsas e Reutilizáveis)
// ==========================================

model Charge {
  id              String     @id @default(uuid())
  asaasId         String?    @unique @map("asaas_id")
  chargeType      ChargeType @default(CUSTOM) @map("charge_type")

  // Cliente (quem paga)
  customerName    String     @map("customer_name")
  customerEmail   String?    @map("customer_email")
  customerCpfCnpj String?   @map("customer_cpf_cnpj")
  customerAsaasId String?    @map("customer_asaas_id")

  billingType     String     @map("billing_type") // PIX, BOLETO, CREDIT_CARD, DEBIT_CARD, UNDEFINED
  value           Decimal    @db.Decimal(12, 2)
  netValue        Decimal?   @db.Decimal(12, 2) @map("net_value") // Valor líquido após taxas do Asaas
  dueDate         DateTime?  @map("due_date")
  description     String?
  status          String     @default("PENDING") // PENDING, CONFIRMED, OVERDUE, REFUNDED, CANCELLED
  maxInstallments Int        @default(1) @map("max_installments")
  isActive        Boolean    @default(true) @map("is_active") // para reutilizáveis

  // Dados de pagamento retornados pelo Asaas
  invoiceUrl      String?    @map("invoice_url")
  bankSlipUrl     String?    @map("bank_slip_url")
  pixQrCode       String?    @map("pix_qr_code")
  pixCopiaECola   String?    @map("pix_copia_e_cola")

  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  splits       ChargeSplit[]
  splitResults SplitResult[]

  @@index([status])
  @@index([chargeType])
  @@index([dueDate])
  @@index([isActive])
  @@map("charges")
}

// ==========================================
// SPLIT POR COBRANÇA (múltiplos destinatários)
// ==========================================

model ChargeSplit {
  id           String   @id @default(uuid())
  chargeId     String   @map("charge_id")
  subaccountId String   @map("subaccount_id")
  percentage   Decimal? @db.Decimal(5, 2)
  fixedValue   Decimal? @map("fixed_value") @db.Decimal(12, 2)

  charge     Charge     @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  subaccount Subaccount @relation(fields: [subaccountId], references: [id])

  @@index([chargeId])
  @@map("charge_splits")
}

// ==========================================
// RESULTADOS DE SPLIT (histórico real)
// ==========================================

model SplitResult {
  id                   String   @id @default(uuid())
  chargeId             String   @map("charge_id")
  receiverSubaccountId String   @map("receiver_subaccount_id")
  value                Decimal  @db.Decimal(12, 2)
  percentage           Decimal? @db.Decimal(5, 2)
  fixedValue           Decimal? @map("fixed_value") @db.Decimal(12, 2)
  status               String   @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt            DateTime @default(now()) @map("created_at")

  charge             Charge     @relation(fields: [chargeId], references: [id])
  receiverSubaccount Subaccount @relation(fields: [receiverSubaccountId], references: [id])

  @@index([chargeId])
  @@index([receiverSubaccountId])
  @@map("split_results")
}

// ==========================================
// CONFIGURAÇÕES PARAMETRIZÁVEIS
// ==========================================

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ==========================================
// LOG DE WEBHOOKS
// ==========================================

model WebhookLog {
  id        String   @id @default(uuid())
  event     String
  payload   Json
  status    String   @default("RECEIVED") // RECEIVED, PROCESSED, FAILED
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([createdAt])
  @@map("webhook_logs")
}
