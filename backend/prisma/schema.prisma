generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUÁRIOS DO PAINEL
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  salt      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ==========================================
// SUBCONTAS ASAAS
// ==========================================

model Subaccount {
  id          String   @id @default(uuid())
  asaasId     String   @unique @map("asaas_id")
  walletId    String?  @map("wallet_id")
  name        String
  cpfCnpj     String   @map("cpf_cnpj")
  email       String?
  phone       String?
  mobilePhone String?  @map("mobile_phone")
  active      Boolean  @default(true)
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  charges              Charge[]
  splitRulesAsCharge   SplitRule[]    @relation("SplitChargeSubaccount")
  splitRulesAsReceiver SplitRule[]    @relation("SplitReceiverSubaccount")
  splitResults         SplitResult[]

  @@map("subaccounts")
}

// ==========================================
// COBRANÇAS
// ==========================================

model Charge {
  id             String   @id @default(uuid())
  asaasId        String?  @unique @map("asaas_id")
  subaccountId   String   @map("subaccount_id")
  billingType    String   @map("billing_type") // BOLETO, PIX, CREDIT_CARD
  value          Decimal  @db.Decimal(12, 2)
  dueDate        DateTime @map("due_date")
  description    String?
  status         String   @default("PENDING") // PENDING, CONFIRMED, OVERDUE, REFUNDED, CANCELLED
  invoiceUrl     String?  @map("invoice_url")
  bankSlipUrl    String?  @map("bank_slip_url")
  pixQrCode      String?  @map("pix_qr_code")
  pixCopiaECola  String?  @map("pix_copia_e_cola")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subaccount   Subaccount    @relation(fields: [subaccountId], references: [id])
  splitResults SplitResult[]

  @@index([status])
  @@index([subaccountId])
  @@index([dueDate])
  @@map("charges")
}

// ==========================================
// REGRAS DE SPLIT
// ==========================================

model SplitRule {
  id                   String   @id @default(uuid())
  chargeSubaccountId   String   @map("charge_subaccount_id")
  receiverSubaccountId String   @map("receiver_subaccount_id")
  type                 String   // PERCENTAGE, FIXED
  value                Decimal  @db.Decimal(12, 4)
  description          String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  chargeSubaccount   Subaccount @relation("SplitChargeSubaccount", fields: [chargeSubaccountId], references: [id])
  receiverSubaccount Subaccount @relation("SplitReceiverSubaccount", fields: [receiverSubaccountId], references: [id])

  @@index([chargeSubaccountId])
  @@map("split_rules")
}

// ==========================================
// RESULTADOS DE SPLIT (histórico)
// ==========================================

model SplitResult {
  id                   String   @id @default(uuid())
  chargeId             String   @map("charge_id")
  receiverSubaccountId String   @map("receiver_subaccount_id")
  value                Decimal  @db.Decimal(12, 2)
  type                 String   // PERCENTAGE, FIXED
  status               String   @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt            DateTime @default(now()) @map("created_at")

  charge             Charge     @relation(fields: [chargeId], references: [id])
  receiverSubaccount Subaccount @relation(fields: [receiverSubaccountId], references: [id])

  @@index([chargeId])
  @@map("split_results")
}

// ==========================================
// LOG DE WEBHOOKS
// ==========================================

model WebhookLog {
  id        String   @id @default(uuid())
  event     String
  payload   Json
  status    String   @default("RECEIVED") // RECEIVED, PROCESSED, FAILED
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([createdAt])
  @@map("webhook_logs")
}
