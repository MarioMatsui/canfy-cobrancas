# === Database ===
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=asaas_split

# === Asaas ===
# Para produção, use https://api.asaas.com/api/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=YOUR_ASAAS_API_KEY

# === Security ===
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
WEBHOOK_SECRET=CHANGE_ME_RANDOM_32_CHARS

# === URLs ===
FRONTEND_URL=http://SEU_DOMINIO
NEXT_PUBLIC_API_URL=/api

# === Ports ===
HTTP_PORT=80
