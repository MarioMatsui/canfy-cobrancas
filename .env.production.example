# === Database ===
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=asaas_split

# === Asaas ===
# Para produção, use https://api.asaas.com/api/v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=YOUR_ASAAS_API_KEY
# Opcional. So habilite se este dominio estiver cadastrado nos dados comerciais da conta Asaas.
# ASAAS_PAYMENT_CALLBACK_BASE_URL=https://pagar.canfy.com.br

# === Security ===
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
WEBHOOK_SECRET=CHANGE_ME_RANDOM_32_CHARS

# === URLs ===
FRONTEND_URL=https://cobranca.canfy.com.br
CHECKOUT_FRONTEND_URL=https://pagar.canfy.com.br
NEXT_PUBLIC_API_URL=/api

# === Ports ===
HTTP_PORT=80
